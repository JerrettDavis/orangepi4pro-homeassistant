        {
          "type": "grid",
          "cards": [
            {
              "type": "markdown",
              "content": "<sub>Projections weight the last 7 days (default 60%) and 30 days (40%) and assume that pace continues to lease end. Excess-mile fees use each vehicle's total contract allowance; unused miles on one lease do not offset the other. Costs are estimates at the rate entered under Setup. The Charger's repair-period pace is not representative of normal use.</sub>"
            }
          ],
          "column_span": 2
        }
