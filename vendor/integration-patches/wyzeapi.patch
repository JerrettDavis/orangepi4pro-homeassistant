+def _build_wyze_ssl_context() -> ssl.SSLContext:
+    """Build an SSL context that still trusts Wyze's current DigiCert root."""
+    global _WYZE_SSL_CONTEXT
+    try:
+        import certifi
+
+        context = ssl.create_default_context(cafile=certifi.where())
+    except ImportError:
+        context = ssl.create_default_context()
+    context.load_verify_locations(cadata=_DIGICERT_GLOBAL_ROOT_CA)
+    _WYZE_SSL_CONTEXT = context
+    return context
+
+
+def _get_wyze_ssl_context() -> ssl.SSLContext:
+    """Return the prebuilt Wyze SSL context."""
+    return _WYZE_SSL_CONTEXT or _build_wyze_ssl_context()
+
+
+def _patch_legacy_wyzeapy_ssl() -> None:
+    """Add the newer wyzeapy SSL helper behavior to older installed builds."""
+    import wyzeapy.wyze_auth_lib as wyze_auth_lib
+
+    class WyzeTCPConnector(TCPConnector):
+        def __init__(self, *args, **kwargs):
+            kwargs.setdefault("ssl", _get_wyze_ssl_context())
+            super().__init__(*args, **kwargs)
+
+    wyze_auth_lib.get_ssl_context = _get_wyze_ssl_context
+    wyze_auth_lib.TCPConnector = WyzeTCPConnector
 
 
