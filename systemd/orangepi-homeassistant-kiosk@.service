[Unit]
Description=Orange Pi Home Assistant touchscreen kiosk for %i
Wants=display-manager.service orangepi-homeassistant.service
After=display-manager.service orangepi-homeassistant.service graphical.target

[Service]
Type=simple
User=%i
Environment=HOME=/home/%i
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/%i/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecCondition=/bin/sh -c 'test ! -e "$HOME/.config/opiha/kiosk.disabled"'
ExecStart=/opt/orangepi-homeassistant/current/scripts/kiosk-session.sh
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStartSec=240
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/home/%i/snap/firefox/common -/home/%i/.cache -/home/%i/.mozilla
