[Unit]
Description=Orange Pi Home Assistant kiosk touch controls (reload, home, restart browser)
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecCondition=/bin/sh -c 'test ! -e "$HOME/.config/opiha/kiosk-controls.disabled"'
ExecStart=/usr/bin/python3 /opt/orangepi-homeassistant/current/scripts/kiosk-controls.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
